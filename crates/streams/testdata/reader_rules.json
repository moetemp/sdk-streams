{
  "comment": "The rules a reader applies on every store. Each case lists the stored records of one topic in log order, and the indexes of the records a read from the start delivers (or a read that resumes after the record at index resume_after, with no state). kind defaults to 1 (DATA), 5 is CLOSE and 6 is TOPIC. topic defaults to \"out\". closed says whether the read ended at a CLOSE.",
  "cases": [
    {
      "label": "a copy after a lost answer is dropped",
      "records": [
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 1
        },
        {
          "producer": "q",
          "attempt": 1,
          "sequence": 1
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 1
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 2
        }
      ],
      "delivered": [
        0,
        1,
        3
      ]
    },
    {
      "label": "a copy of a whole batch is dropped",
      "records": [
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 1
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 2
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 1
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 2
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 3
        }
      ],
      "delivered": [
        0,
        1,
        4
      ]
    },
    {
      "label": "a record with no sequence is never a copy",
      "records": [
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 0
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 0
        }
      ],
      "delivered": [
        0,
        1
      ]
    },
    {
      "label": "a gap in the sequence is no copy",
      "records": [
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 1
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 4
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 3
        }
      ],
      "delivered": [
        0,
        1
      ]
    },
    {
      "label": "a copy of an older attempt is delivered as stale",
      "records": [
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 1
        },
        {
          "producer": "p",
          "attempt": 2,
          "sequence": 1
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 1
        }
      ],
      "delivered": [
        0,
        1,
        2
      ],
      "stale": [
        2
      ]
    },
    {
      "label": "producers count their sequences apart",
      "records": [
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 1
        },
        {
          "producer": "q",
          "attempt": 1,
          "sequence": 1
        },
        {
          "producer": "q",
          "attempt": 1,
          "sequence": 1
        }
      ],
      "delivered": [
        0,
        1
      ]
    },
    {
      "label": "a read from a cursor knows the cursor record's sequence",
      "records": [
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 1
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 2
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 2
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 3
        }
      ],
      "resume_after": 1,
      "delivered": [
        3
      ]
    },
    {
      "label": "a read from a cursor can deliver a copy whose first copy came before it",
      "records": [
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 1
        },
        {
          "producer": "q",
          "attempt": 1,
          "sequence": 1
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 1
        }
      ],
      "resume_after": 1,
      "delivered": [
        2
      ]
    },
    {
      "label": "the first close ends the topic",
      "records": [
