      "records": [
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 1
        },
        {
          "producer": "c",
          "attempt": 1,
          "sequence": 0,
          "kind": 5
        },
        {
          "producer": "p",
          "attempt": 1,
