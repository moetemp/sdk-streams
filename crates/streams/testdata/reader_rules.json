          "producer": "p",
          "attempt": 1,
          "sequence": 1
        },
        {
          "producer": "c",
          "attempt": 1,
          "sequence": 0,
          "kind": 5,
          "topic": ""
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 2
        }
      ],
      "delivered": [
        0
      ],
      "closed": true
    },
    {
      "label": "another topic's close and a topic name are skipped",
      "records": [
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 1
        },
        {
          "producer": "c",
          "attempt": 1,
          "sequence": 0,
          "kind": 5,
          "topic": "other"
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 0,
          "kind": 6
        },
        {
          "producer": "p",
          "attempt": 1,
          "sequence": 2
        }
